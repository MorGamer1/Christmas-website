{%- comment -%}
  "Shop by category": a grid of big picture tiles, one per collection.
  The first tile is the big one. Each tile uses the collection's image; if it has none,
  the theme's own Christmas illustration is used for lights, decorations, table, gifts and cosy.
{%- endcomment -%}
{%- liquid
  assign tiles = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign tiles = tiles | plus: 1
    endif
  endfor
-%}
{%- if tiles > 0 or request.design_mode -%}
  {% render 'section-padding', section: section %}
  <section
    class="color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
    aria-labelledby="Heading-{{ section.id }}"
  >
    <div class="container">
      <div class="section-head">
        <h2 class="t-heading-l" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.link_label != blank -%}
          <a class="link-arrow" href="{{ routes.all_products_collection_url }}">
            <span class="u">{{ section.settings.link_label | escape }}</span>
            {% render 'icon', name: 'arrow', class: 'icon--sm' %}
          </a>
        {%- endif -%}
      </div>

      {%- if tiles > 0 -%}
        <div class="bento">
          {%- assign tile_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.collection != blank -%}
              {%- assign tile_index = tile_index | plus: 1 -%}
              {%- assign is_lead = false -%}
              {%- if tile_index == 1 -%}
                {%- assign is_lead = true -%}
              {%- endif -%}
              {% render 'card-collection',
                collection: block.settings.collection,
                lead: is_lead,
                show_count: section.settings.show_count,
                shopify_attributes: block.shopify_attributes
              %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="callout">
          {% render 'icon', name: 'info' %}
          <span>{{ 'sections.collection_list.editor_note' | t }}</span>
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "section-categories",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Shop all",
      "info": "Links to all products. Leave empty for no link."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show the number of products",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
