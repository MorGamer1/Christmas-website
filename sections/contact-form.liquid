{%- comment -%}
  Contact form. Messages arrive in your store email (Settings > Notifications > Sender email), and a copy is kept in Shopify Inbox if you use it.
  Add it to a page that uses the template "page.contact".
{%- endcomment -%}
{% render 'section-padding', section: section %}
{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
-%}
<section
  class="color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
  aria-labelledby="Heading-{{ section.id }}"
>
  <div class="container">
    <div class="contact">
      <div class="contact__intro">
        <h2 class="t-heading-l" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="muted">{% render 'replace-tokens', text: section.settings.text %}</p>
        {%- endif -%}
      </div>

      {%- form 'contact', id: form_id, class: 'contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-msg" role="status" tabindex="-1" autofocus>{{ 'sections.contact.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-msg" data-kind="error" role="alert" tabindex="-1" autofocus>
            {{- form.errors | default_errors -}}
          </div>
        {%- endif -%}

        <div class="contact__row">
          <div class="field">
            <label for="{{ form_id }}-name">{{ 'sections.contact.name' | t }}</label>
            <input
              class="input"
              type="text"
              id="{{ form_id }}-name"
              name="contact[name]"
              autocomplete="name"
              value="{% if form.name != blank %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
            >
          </div>
          <div class="field">
            <label for="{{ form_id }}-email">{{ 'sections.contact.email' | t }}</label>
            <input
              class="input"
              type="email"
              id="{{ form_id }}-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email != blank %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
              {% endif %}
            >
          </div>
        </div>

        {%- if section.settings.show_phone -%}
          <div class="field">
            <label for="{{ form_id }}-phone">{{ 'sections.contact.phone' | t }}</label>
            <input
              class="input"
              type="tel"
              id="{{ form_id }}-phone"
              name="contact[phone]"
              autocomplete="tel"
              pattern="[0-9\-\+\s\(\)]*"
              value="{{ form.phone | escape }}"
            >
          </div>
        {%- endif -%}

        <div class="field">
          <label for="{{ form_id }}-body">{{ 'sections.contact.message' | t }}</label>
          <textarea
            class="textarea"
            id="{{ form_id }}-body"
            name="contact[body]"
            rows="6"
            required
            {% if form.errors contains 'body' %}
              aria-invalid="true"
            {% endif %}
          >{{ form.body }}</textarea>
        </div>

        <div class="contact__actions">
          <button class="btn btn--primary btn--l" type="submit">{{ 'sections.contact.send' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Send us a message"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "We usually reply within one working day. Please add your order number if your question is about an order.",
      "info": "You can use {email}."
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Ask for a phone number",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
