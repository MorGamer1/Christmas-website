{%- comment -%}
  The page visitors see while the store is closed (Online Store > Preferences > Password protection).
  The message comes from that same Preferences page. You can also collect emails for the opening day here.
{%- endcomment -%}
{%- liquid
  assign form_id = 'PasswordSignup-' | append: section.id
-%}
<div class="password color-{{ section.settings.color_scheme }}">
  <div class="container password__inner">
    <p class="logo password__logo">
      <span>{{ shop.name | escape }}</span>
      <svg class="logo__star" aria-hidden="true" focusable="false"><use href="#i-sparkle"></use></svg>
    </p>

    <div class="password__copy">
      <h1 class="t-display-l">{{ section.settings.heading | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="t-body-l muted">{{ shop.password_message | escape | newline_to_br }}</p>
      {%- elsif section.settings.text != blank -%}
        <p class="t-body-l muted">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_signup -%}
      {%- form 'customer', id: form_id, class: 'password__signup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, password-page">
        <div class="field">
          <label for="{{ form_id }}-email">{{ 'sections.email_signup.label' | t }}</label>
          <input
            class="input"
            id="{{ form_id }}-email"
            name="contact[email]"
            type="email"
            autocomplete="email"
            placeholder="{{ 'sections.email_signup.placeholder' | t }}"
            value="{{ form.email }}"
            required
          >
        </div>
        <button class="btn btn--primary btn--l" type="submit">{{ section.settings.button_label | escape }}</button>
        {%- if form.posted_successfully? -%}
          <p class="form-msg" role="status" tabindex="-1" autofocus>{{ 'sections.email_signup.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-msg" data-kind="error" role="alert">
            {{- form.errors | default_errors -}}
          </div>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <details class="password__enter" data-password-enter>
      <summary>
        {% render 'icon', name: 'lock', class: 'icon--sm' %}
        <span>{{ 'sections.password.enter' | t }}</span>
      </summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          <div class="form-msg" data-kind="error" role="alert">
            {{- form.errors | default_errors -}}
          </div>
        {%- endif -%}
        <div class="field">
          <label for="Password-{{ section.id }}">{{ 'sections.password.label' | t }}</label>
          <input
            class="input"
            type="password"
            name="password"
            id="Password-{{ section.id }}"
            autocomplete="current-password"
            required
          >
        </div>
        <button class="btn btn--secondary" type="submit">{{ 'sections.password.submit' | t }}</button>
      {%- endform -%}
      <p class="muted password__owner">
        {{ 'sections.password.owner' | t }}
        <a href="/admin">{{ 'sections.password.owner_link' | t }}</a>
      </p>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Our Christmas shop is almost ready.",
      "info": "Used when there is no message in Online Store > Preferences > Password protection."
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Collect emails for the opening day",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Email button text",
      "default": "Tell me when it opens"
    }
  ]
}
{% endschema %}
