{%- comment -%}
  "You might also like" under a product. Shopify chooses the products (similar items, or what other shoppers bought with it).
  The section loads after the page, so it never slows the first view. If Shopify has nothing to suggest yet
  (a brand new store has little data), the section simply stays hidden.
{%- endcomment -%}
{% render 'section-padding', section: section %}
<div
  class="product-recs color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
  data-product-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit={{ section.settings.products_to_show }}&amp;intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="section-head">
        <h2 class="t-heading-l">{{ section.settings.heading | escape }}</h2>
      </div>
      <ul class="cards" role="list">
        {%- for recommended_product in recommendations.products -%}
          <li class="cards__item">
            {% render 'card-product', product: recommended_product %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product recommendations",
  "class": "section-recommendations",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 2,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 88
    }
  ]
}
{% endschema %}
