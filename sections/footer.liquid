{%- comment -%}
  Footer: logo and short text, up to four columns of links (each one is a menu from Navigation),
  company details, store policies and payment methods.
{%- endcomment -%}
<footer class="site-footer color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {%- if settings.logo != blank -%}
            {{
              settings.logo
              | image_url: width: 480
              | image_tag:
                class: 'logo__img',
                width: settings.logo_width,
                sizes: '240px',
                widths: '120, 240, 360, 480',
                loading: 'lazy',
                alt: ''
            }}
          {%- else -%}
            <span>{{ shop.name | escape }}</span>
            <svg class="logo__star" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#i-sparkle"/></svg>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p>{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        {%- if section.settings.show_social -%}
          {% render 'social-links' %}
        {%- endif -%}
        {%- render 'localization-form',
          id: 'FooterLocalization',
          show_language: section.settings.show_language_selector,
          show_country: section.settings.show_country_selector
        -%}
      </div>

      {%- liquid
        assign link_columns = 0
        for block in section.blocks
          if block.settings.menu.links.size > 0
            assign link_columns = link_columns | plus: 1
          endif
        endfor
      -%}
      {%- if link_columns > 0 -%}
        <div class="footer__cols">
          {%- for block in section.blocks -%}
            {%- assign block_menu = block.settings.menu -%}
            {%- if block_menu.links.size > 0 -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2>{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <ul role="list">
                  {%- for link in block_menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      <div>
        {%- if section.settings.legal_text != blank -%}
          <div class="footer__legal">{{ section.settings.legal_text }}</div>
        {%- endif -%}
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if section.settings.show_payment -%}
        {% render 'payment-icons' %}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-3"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Short text under the logo",
      "default": "Christmas lights, decorations and gifts at fair prices."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media icons",
      "default": true,
      "info": "Add the links in Theme settings > Social media."
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "default": true,
      "info": "Shows only when your store has more than one language (Settings > Languages)."
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country selector",
      "default": true,
      "info": "Shows only when your store sells in more than one country (Settings > Markets)."
    },
    {
      "type": "richtext",
      "id": "legal_text",
      "label": "Company details",
      "default": "<p>[Company name] · [Street, postcode, city, country] · VAT [VAT number] · [contact email]</p>",
      "info": "Shops in the EU have to show who runs them. Replace the text in square brackets before you launch."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show store policies",
      "default": true,
      "info": "Privacy policy, terms of service, refund and shipping policy. Write them in Settings > Policies."
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment methods",
      "default": true,
      "info": "The list follows Settings > Payments."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Create menus in Content > Menus."
        }
      ]
    }
  ]
}
{% endschema %}
