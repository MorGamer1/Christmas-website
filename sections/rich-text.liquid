{%- comment -%}
  A block of text with an optional button: a short story, a promise, a note about delivery.
  You can use {date} {short_date} {dispatch} {transit} {returns} {free_shipping} {shipping_fee} {email} in the text:
  they are filled in from Theme settings > Christmas and delivery.
{%- endcomment -%}
{% render 'section-padding', section: section %}
<section
  class="color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
  {% if section.settings.heading != blank %}
    aria-labelledby="Heading-{{ section.id }}"
  {% endif %}
>
  <div class="container">
    <div class="richtext richtext--{{ section.settings.alignment }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="t-heading-xl" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte t-body-l">
          {% render 'replace-tokens', text: section.settings.text, html: true %}
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="btn btn--primary btn--l" href="{{ section.settings.button_link }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the last-minute gift"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Order by {date} and your parcel is on its way to arrive before Christmas.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
