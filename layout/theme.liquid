<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_schemes['scheme-1'].settings.background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}

    {%- unless settings.use_custom_fonts -%}
      {{ 'geist-latin-wght.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: '' }}
      {{ 'bricolage-grotesque-latin-opsz.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: '' }}
    {%- endunless -%}

    {%- assign tags_text = current_tags | join: ', ' -%}
    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ 'general.meta.tagged' | t: tags: tags_text }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% render 'css-variables' %}

    {{ 'theme-base.css' | asset_url | stylesheet_tag }}
    {{ 'theme-pages.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body class="color-scheme-1 template-{{ template.name | handleize }}">
    <a class="skip" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% render 'icon-sprite' %}

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1" data-template="{{ template.name }}">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and request.page_type != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div class="visually-hidden" id="LiveRegion" role="status" aria-live="polite"></div>

    <script>
      window.Firside = {
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartUpdate: {{ routes.cart_update_url | append: '.js' | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          cartError: {{ 'cart.general.error' | t | json }},
          quantityError: {{ 'cart.general.quantity_error' | t: quantity: '[quantity]' | json }},
          added: {{ 'cart.general.added' | t: title: '[title]' | json }},
          updated: {{ 'cart.general.updated' | t | json }},
          removed: {{ 'cart.general.removed' | t: title: '[title]' | json }},
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          inStock: {{ 'products.product.in_stock' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }}
        }
      };
    </script>
  </body>
</html>
