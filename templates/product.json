{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "highlights": {
          "type": "highlights",
          "settings": {}
        },
        "variant-picker": {
          "type": "variant_picker",
          "settings": {}
        },
        "buy-buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity": true,
            "show_dynamic_checkout": true
          }
        },
        "delivery-note": {
          "type": "delivery_note",
          "settings": {}
        },
        "trust-1": {
          "type": "trust_item",
          "settings": {
            "icon": "truck",
            "title": "Tracked delivery",
            "text": "Tracking link by email when it ships."
          }
        },
        "trust-2": {
          "type": "trust_item",
          "settings": {
            "icon": "returns",
            "title": "{returns}-day returns",
            "text": "Unused items, in their packaging."
          }
        },
        "trust-3": {
          "type": "trust_item",
          "settings": {
            "icon": "lock",
            "title": "Secure checkout",
            "text": "Encrypted payment. No account needed."
          }
        },
        "fold-description": {
          "type": "accordion",
          "settings": {
            "type": "description",
            "open": true
          }
        },
        "fold-details": {
          "type": "accordion",
          "settings": {
            "type": "details"
          }
        },
        "fold-safety": {
          "type": "accordion",
          "settings": {
            "type": "safety"
          }
        },
        "fold-shipping": {
          "type": "accordion",
          "settings": {
            "type": "shipping",
            "content": "<p>Delivery is {shipping_fee}, free over {free_shipping}. Orders are dispatched within {dispatch} and take {transit} to arrive. Parcels may arrive separately.</p><p>You can return unused items within {returns} days of receiving them.</p>"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "highlights",
        "variant-picker",
        "buy-buttons",
        "delivery-note",
        "trust-1",
        "trust-2",
        "trust-3",
        "fold-description",
        "fold-details",
        "fold-safety",
        "fold-shipping"
      ],
      "settings": {}
    },
    "reviews": {
      "type": "product-reviews",
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 56
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "You may also need",
        "products_to_show": 4,
        "padding_top": 24,
        "padding_bottom": 88
      }
    }
  },
  "order": [
    "main",
    "reviews",
    "recommendations"
  ]
}
